{
  "profiles": {
    "personal": {
      "description": "Personal projects, personal billing",
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY_PERSONAL}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY_PERSONAL}"
      }
    },
    "acme-dev": {
      "description": "Acme sandbox keys (dev billing tier)",
      "env": {
        "ANTHROPIC_API_KEY": "!op read op://Acme/anthropic-dev/credential",
        "ACME_API_TOKEN": "file:C:/Users/me/.secrets/acme-dev-token.txt",
        "ACME_API_BASE": "https://api.dev.acme.example"
      },
      "unset": ["OPENAI_API_KEY"]
    },
    "acme-prod": {
      "description": "Acme production",
      "warn": "PRODUCTION keys are active. Double-check before running anything that writes.",
      "env": {
        "ANTHROPIC_API_KEY": "!op read op://Acme/anthropic-prod/credential",
        "ACME_API_TOKEN": "!op read op://Acme/acme-prod/token"
      },
      "unset": ["OPENAI_API_KEY"]
    }
  },
  "rules": [
    { "profile": "acme-dev", "remote": "github.com/acme/*" },
    { "profile": "acme-dev", "remoteName": "acme-*" },
    { "profile": "acme-dev", "path": "D:/work/acme/**" },
    { "profile": "personal", "path": "D:/vibe-repos/**" }
  ],
  "default": "personal",
  "redact": true
}
